{
  "name": "com-brasper-backofice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--experimental-global-webcrypto vue-tsc -b && NODE_OPTIONS=--experimental-global-webcrypto vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:api-paths": "node scripts/check-api-paths.mjs",
    "sync:api-routes": "node scripts/sync-api-routes.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:api-paths",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "version:info": "node scripts/app-version.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "apexcharts": "^5.15.2",
    "axios": "^1.7.7",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue3-apexcharts": "^1.11.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
